{
  "name": "Bloc",
  "type": "object",
  "properties": {
    "seance_programme_id": {
      "type": "string",
      "title": "S\u00e9ance"
    },
    "titre": {
      "type": "string",
      "title": "Titre du bloc"
    },
    "ordre": {
      "type": "number",
      "default": 0,
      "title": "Ordre"
    },
    "nb_series": {
      "type": "number",
      "default": 1,
      "title": "Nombre de s\u00e9ries (g\u00e9r\u00e9 au niveau du bloc)"
    },
    "repos_entre_exercices": {
      "type": "number",
      "default": 60,
      "title": "Repos entre exercices (sec) \u2014 obsol\u00e8te (non configur\u00e9)"
    },
    "rounds": {
      "type": "number",
      "default": 1,
      "title": "Nombre de tours (rounds)"
    },
    "rest_between_rounds": {
      "type": "number",
      "default": 60,
      "title": "Repos entre tours"
    },
    "rest_between_rounds_unit": {
      "type": "string",
      "enum": [
        "secondes",
        "minutes"
      ],
      "default": "secondes",
      "title": "Unit\u00e9 du repos entre tours"
    }
  },
  "required": [
    "seance_programme_id",
    "titre"
  ]
}