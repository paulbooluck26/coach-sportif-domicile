{
  "name": "ClientProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID du User associ\u00e9"
    },
    "nom": {
      "type": "string",
      "description": "Nom complet du client"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "telephone": {
      "type": "string"
    },
    "adresse": {
      "type": "string",
      "description": "Adresse d'intervention \u00e0 domicile"
    },
    "objectif": {
      "type": "string",
      "description": "Objectif principal du client"
    },
    "notes": {
      "type": "string",
      "description": "Notes internes du coach"
    },
    "date_naissance": {
      "type": "string",
      "format": "date"
    },
    "photo_url": {
      "type": "string",
      "title": "Photo de profil (URL)",
      "description": "URL de la photo de profil carr\u00e9e compress\u00e9e"
    }
