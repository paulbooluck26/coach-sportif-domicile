{
  "name": "DemandeContact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nom"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "title": "T\u00e9l\u00e9phone"
    },
    "goal": {
      "type": "string",
      "title": "Objectif"
    },
    "message": {
      "type": "string",
      "title": "Message"
    },
    "statut": {
      "type": "string",
      "enum": [
        "nouveau",
        "en_cours",
        "traite",
        "appel_a_passer",
        "appel_confirme",
        "appel_realise",
        "appel_annule"
      ],
      "default": "nouveau",
      "title": "Statut"
    },
    "type_demande": {
      "type": "string",
      "enum": [
        "contact",
        "appel_decouverte"
      ],
      "default": "contact",
      "title": "Type de demande"
    },
    "date_souhaitee": {
      "type": "string",
      "format": "date",
      "title": "Date souhait\u00e9e (appel)"
    },
    "heure_souhaitee": {
      "type": "string",
      "title": "Heure souhait\u00e9e (appel)"
    }
  },
  "required": [
    "name",
    "email",
    "message"
  ]
}