{
  "name": "Mouvement",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "title": "Nom du mouvement"
    },
    "famille": {
      "type": "string",
      "title": "Famille de mouvement",
      "description": "Regroupe les variantes d'un m\u00eame mouvement (ex : Squat \u2192 Back Squat, Front Squat, Goblet Squat). Les mouvements d'une m\u00eame famille s'affichent automatiquement dans la fiche."
    },
    "categorie": {
      "type": "string",
      "enum": [
        "push",
        "jambes",
        "tirage",
        "gainage",
        "dos",
        "epaules",
        "cardio",
        "mobilite",
        "autre"
      ],
      "default": "push",
      "title": "Cat\u00e9gorie de mouvement"
    },
    "type_mouvement": {
      "type": "string",
      "enum": [
        "polyarticulaire",
        "isolation",
        "gainage",
        "plyometrie",
        "mobilite",
        "cardio",
        "halterophilie",
        "autre"
      ],
      "default": "polyarticulaire",
      "title": "Type de mouvement"
    },
    "niveau": {
      "type": "string",
      "enum": [
        "debutant",
        "intermediaire",
        "avance"
      ],
      "default": "debutant",
      "title": "Niveau"
    },
    "difficulte_technique": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "default": 1,
      "title": "Difficult\u00e9 technique (1-5)",
      "description": "Ind\u00e9pendant du niveau D\u00e9butant/Interm\u00e9diaire/Avanc\u00e9."
    },
    "muscles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Muscles principaux"
    },
    "muscles_secondaires": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Muscles secondaires"
    },
    "materiel": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Mat\u00e9riel n\u00e9cessaire"
    },
    "mots_cles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Tags"
    },
    "objectif": {
      "type": "string",
      "title": "Objectif de l'exercice"
    },
    "description": {
      "type": "string",
      "title": "Ex\u00e9cution (\u00e9diteur riche HTML)",
      "description": "Contenu p\u00e9dagogique riche \u00e9dit\u00e9 via Quill."
    },
    "points_cles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Points cl\u00e9s"
    },
    "erreurs": {
      "type": "string",
      "title": "Erreurs fr\u00e9quentes"
    },
    "conseils": {
      "type": "string",
      "title": "Conseils du coach"
    },
    "variantes_faciles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Variantes plus faciles (IDs de mouvements)"
    },
    "variantes_difficiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Variantes plus difficiles (IDs de mouvements)"
    },
    "video_url": {
      "type": "string",
      "title": "Vid\u00e9o / GIF (URL)"
    },
    "image_url": {
      "type": "string",
      "title": "Image principale (URL)"
    },
    "ordre": {
      "type": "number",
      "default": 0,
      "title": "Ordre d'affichage"
    },
    "statut": {
      "type": "string",
      "enum": [
        "brouillon",
        "publie"
      ],
      "default": "publie",
      "title": "Statut"
    }
  },
  "required": [
    "nom",
    "categorie",
    "niveau",
    "statut"
  ]
}