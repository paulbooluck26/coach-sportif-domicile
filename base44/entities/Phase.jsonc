      "title": "Programme"
    },
    "nom": {
      "type": "string",
      "title": "Nom de la phase"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "ordre": {
      "type": "number",
      "default": 0,
      "title": "Ordre dans le programme"
    },
    "nb_semaines": {
      "type": "number",
