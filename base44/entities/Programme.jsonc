{
  "name": "Programme",
  "type": "object",
  "properties": {
    "client_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Clients (user IDs)"
    },
    "client_names": {
      "type": "string",
      "title": "Noms des clients"
    },
    "name": {
      "type": "string",
      "title": "Nom du programme"
    },
    "duration_weeks": {
      "type": "number",
      "default": 4,
      "title": "Dur\u00e9e (semaines)"
    },
    "objective": {
      "type": "string",
      "title": "Objectif"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "statut": {
      "type": "string",
      "enum": [
        "brouillon",
        "actif",
        "termine"
      ],
      "default": "brouillon",
      "title": "Statut"
    }
  },
  "required": [
    "name"
  ]
}