{
  "name": "Programme",
  "type": "object",
  "properties": {
    "client_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Clients (user IDs) \u2014 obsol\u00e8te (CycleClient)"
    },
    "client_names": {
      "type": "string",
      "title": "Noms des clients \u2014 obsol\u00e8te (CycleClient)"
    },
    "name": {
      "type": "string",
      "title": "Nom du programme"
    },
    "duration_weeks": {
      "type": "number",
      "default": 4,
      "title": "Dur\u00e9e (semaines)"
    },
    "objective": {
      "type": "string",
      "title": "Objectif"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "statut": {
      "type": "string",
      "enum": [
        "brouillon",
        "actif",
        "termine"
      ],
      "default": "brouillon",
      "title": "Statut"
    },
    "offre": {
      "type": "string",
      "enum": [
        "start",
        "forge",
        "legacy"
      ],
      "title": "Niveau d'offre"
    },
    "cycle_id": {
      "type": "string",
      "title": "Cycle li\u00e9 (informatif \u2014 la source principale est CycleClient.programme_id)"
    }
  },
  "required": [
    "name"
  ]
}