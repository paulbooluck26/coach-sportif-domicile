{
  "name": "Programme",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "title": "Client (user ID)"
    },
    "client_name": {
      "type": "string",
      "title": "Nom du client"
    },
    "name": {
      "type": "string",
      "title": "Nom du programme"
    },
    "duration_weeks": {
      "type": "number",
      "default": 4,
      "title": "Dur\u00e9e (semaines)"
    },
    "objective": {
      "type": "string",
      "title": "Objectif"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "statut": {
      "type": "string",
      "enum": [
        "brouillon",
        "actif",
        "termine"
      ],
      "default": "brouillon",
      "title": "Statut"
    }
  },
  "required": [
    "client_id",
    "name"
  ]
}