{
  "name": "SeanceProgramme",
  "type": "object",
  "properties": {
    "semaine_id": {
      "type": "string",
      "title": "Semaine"
    },
    "titre": {
      "type": "string",
      "title": "Titre de la s\u00e9ance"
    },
    "jours_semaine": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 6
      },
      "title": "Jours de la semaine"
    },
    "type_seance": {
      "type": "string",
      "enum": [
        "force",
        "cardio",
        "mobilite",
        "recuperation",
        "mixte"
      ],
      "default": "force",
      "title": "Type de s\u00e9ance"
    },
    "description": {
      "type": "string",
      "title": "Notes / description"
    },
    "ordre": {
      "type": "number",
      "default": 0,
      "title": "Ordre"
    }
  },
  "required": [
    "semaine_id",
    "titre"
  ]
}